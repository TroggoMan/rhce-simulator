# Control node for the lab — the machine you actually work FROM, as opposed
# to the managed nodes you work ON.
#
# Deliberately bare. It does NOT pre-install ansible-core, rhel-system-roles,
# collections or ansible-navigator, and it does NOT come with a clone of the
# simulator baked in. You `git clone` this repo and run the exact same
# ./scripts/bootstrap.sh from inside this container that the README has you
# run on a real host — bootstrap.sh already detects RHEL-family/dnf and
# installs all of that (see its FAMILY=rhel branch), so there is exactly one
# install path, used identically whether you're on your own workstation or
# in here. That also means it's a genuinely self-contained practice
# environment — no bind mount of the host's checkout, no host-native
# absolute paths — closer to what the real exam's control node actually is:
# a fresh machine you set up yourself.
#
# What IS pre-installed here is OS-level: just enough to get in, clone the
# repo, and reach managed nodes, none of which bootstrap.sh provisions on
# ANY platform today (a bare container, unlike a desktop OS, doesn't have
# these by default):
#   * git — to clone the repo in the first place.
#   * openssh-clients, sshpass — ssh/ssh-keygen and the -k/ansible_password
#     first connection to a fresh managed node.
#   * rsync — the synchronize module.
#   * vim/nano/less/tar/procps-ng — it's an interactive shell, make it usable.
#
# Deliberately NOT a systemd container: this is a workstation, not a managed
# node. It idles and you exec into it.
FROM rockylinux/rockylinux:10

# Matched to the invoking user so the persisted home directory doesn't come
# back owned by root. docker-compose.yml passes the real values.
ARG user_uid=1000
ARG user_gid=1000
ARG username=student

RUN dnf -y install git openssh-clients sshpass rsync sudo which \
        vim-enhanced nano less tar procps-ng \
    && dnf clean all

RUN groupadd -g "$user_gid" "$username" 2>/dev/null || true \
    && useradd -u "$user_uid" -g "$user_gid" -m -s /bin/bash "$username" \
    && echo "$username ALL=(ALL) NOPASSWD: ALL" > "/etc/sudoers.d/$username" \
    && chmod 0440 "/etc/sudoers.d/$username"

USER $username
WORKDIR /home/$username

ENV PATH=/home/student/.local/bin:$PATH

CMD ["sleep", "infinity"]
