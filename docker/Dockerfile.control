# Control node for the lab — the machine you actually work FROM.
#
# Why this exists: the managed nodes were always RHEL-family, but the
# control node was whatever workstation you happened to run the simulator
# on. Several exam behaviours live on the control node, not the managed
# ones, and they were all missing:
#
#   * rhel-system-roles / the redhat.rhel_system_roles namespace. This is
#     an RPM in RHEL-family AppStream and a collection on Red Hat
#     Automation Hub — it is NOT on public Galaxy, so
#     `ansible-galaxy collection install redhat.rhel_system_roles` fails
#     for anyone without a subscription. Rocky ships the RPM, which gets
#     the genuine namespace here for free.
#   * ansible-core's VERSION. RHEL 10 ships 2.16; a current workstation
#     is likely on 2.2x, where module deprecations and behaviour differ
#     from what the exam grades.
#   * The RHEL tooling in general — domains 5 and 7 are explicitly about
#     the navigator/execution-environment workflow.
#
# Deliberately NOT a systemd container: this is a workstation, not a
# managed node. It idles and you exec into it.
FROM rockylinux/rockylinux:10

# Matched to the invoking user so bind-mounted playbooks don't come back
# owned by root on the host. docker-compose.yml passes the real values.
ARG user_uid=1000
ARG user_gid=1000
ARG username=student

# ansible-core + rhel-system-roles are the point of the image.
# git: domain 6 is graded by real clone/commit/push.
# openssh-clients: ssh/ssh-keygen/ssh-copy-id for the bootstrap task.
# sshpass: ansible needs it for -k / ansible_password, which is exactly
#   how the first connection to a fresh node has to be made.
# rsync: the synchronize module.
# vim/nano/less/tar/procps-ng: it's an interactive shell, make it usable.
RUN dnf -y install ansible-core rhel-system-roles git openssh-clients \
        sshpass rsync python3-pip vim-enhanced nano less tar procps-ng \
        sudo which \
    && dnf clean all

# ansible-core ships no collections at all. rhel-system-roles above gets the
# redhat.rhel_system_roles namespace for free (it's an RPM, not a Galaxy
# collection), but most of the rest of the task catalog needs
# ansible.posix (firewalld/mount/seboolean/authorized_key) and
# community.general (lvol/lvg/parted/seport/sefcontext/archive) — without
# these a candidate's correct playbook fails with "couldn't resolve
# module/action", which reads like their mistake, not a missing dependency.
# Installed as root, so -p pins it to the system-wide collections path
# (also where the rhel-system-roles RPM lands its own collection) — the
# default ~/.ansible/collections would otherwise go to /root and be
# invisible to the $username user created below.
RUN ansible-galaxy collection install -p /usr/share/ansible/collections \
        ansible.posix community.general

# ansible-navigator isn't packaged for Rocky 10, and pip is the documented
# install path. Note it drives execution environments via podman, which
# won't run nested here — use --execution-environment false on this node.
# Navigator's other job, `ansible-navigator doc`, works fine either way and
# is the part worth practising: the exam gives you no internet.
RUN python3 -m pip install --no-cache-dir ansible-navigator || \
    echo "ansible-navigator unavailable — nav tasks will report it missing"

RUN groupadd -g "$user_gid" "$username" 2>/dev/null || true \
    && useradd -u "$user_uid" -g "$user_gid" -m -s /bin/bash "$username" \
    && echo "$username ALL=(ALL) NOPASSWD: ALL" > "/etc/sudoers.d/$username" \
    && chmod 0440 "/etc/sudoers.d/$username"

# The simulator itself is a real git clone, not a bind mount of whatever
# happens to be checked out on the host — this container is meant to be a
# self-contained practice environment (closer to the exam's own control
# node, which is a fresh machine), not a window into the host's working
# tree/absolute paths/local results.db. This is a point-in-time snapshot,
# not live-synced: refresh with `git pull` inside the container, or rebuild
# with `docker compose build --no-cache control` for a clean re-clone.
# data/ is gitignored and untracked, so the clone won't create it — mkdir it
# up front, still as root, so docker-compose.yml's named volume over it
# seeds with the right ownership instead of coming back root-owned.
ARG repo_url=https://github.com/TroggoMan/rhce-simulator.git
RUN git clone --depth 1 "$repo_url" /opt/rhce-simulator \
    && mkdir -p /opt/rhce-simulator/data \
    && chown -R "$username:$username" /opt/rhce-simulator

USER $username

# Created here, as this user, so the named volume compose mounts over it
# inherits the right ownership and mode — Docker seeds a fresh volume from
# whatever the image has at that path, and an absent directory would come
# back owned by root and unwritable.
RUN mkdir -p "/home/$username/.ssh" && chmod 0700 "/home/$username/.ssh"

WORKDIR /home/$username/ansible

ENV RHCE_SIM_WORKDIR=/home/student/ansible \
    PATH=/home/student/.local/bin:$PATH

CMD ["sleep", "infinity"]
